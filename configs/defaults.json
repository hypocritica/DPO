{
  "seed": 17,
  "data": {
    "pairs": "${PICKAPIC_SD15_PREPARED}/pairs.jsonl",
    "split": "train",
    "require_reviewed": false,
    "require_human_preference": true,
    "num_workers": 4,
    "validation": "auto",
    "validation_workers": 8,
    "validation_samples": 8
  },
  "training": {
    "objective": "dpo",
    "dtype": "bfloat16",
    "resolution": 512,
    "max_steps": 2000,
    "batch_size": 8,
    "gradient_accumulation_steps": 32,
    "sampling": "balanced",
    "prompt_mode": "canonical",
    "checkpoint_policy": "bounded",
    "max_lora_checkpoints": null,
    "checkpoint_every": 200,
    "learning_rate": 1e-05,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "lora_rank": 16,
    "lora_alpha": 16,
    "gradient_checkpointing": true,
    "beta": 5000.0,
    "temperature": 0.1,
    "consistency_weight": 0.0,
    "warmup_steps": 200,
    "lr_schedule": "constant",
    "diagnostic": {
      "pairs": 4,
      "every": 250,
      "seed": 271828
    },
    "world_size": 1,
    "logging": "tensorboard",
    "vae_batch_size": 4,
    "lora_checkpoint_every": 1000,
    "launcher": "accelerate",
    "wandb": {
      "project": "self-correct-dpo",
      "mode": "offline"
    }
  },
  "evaluation": {
    "enabled": true,
    "prompts": "${MONITOR_PROMPTS_SD15}",
    "scorers_config": "scorers.json",
    "expected_prompts": 128,
    "first_step": 200,
    "every": 500,
    "include_base": true,
    "keep_images_every": 1000,
    "sampling": {
      "scheduler": "DDIMScheduler",
      "dtype": "bfloat16",
      "height": 512,
      "width": 512,
      "num_inference_steps": 30,
      "guidance_scale": 7.5,
      "negative_prompt": "",
      "seeds": [
        17
      ],
      "prompt_truncation": "truncate",
      "safety_checker": "disabled"
    }
  }
}
