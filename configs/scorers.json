{
  "scorers": {
    "pickscore": {
      "model": "${PICKSCORE_MODEL}",
      "processor": "${PICKSCORE_PROCESSOR}"
    },
    "clip": {
      "open_clip_source": "${HPSV2_MODEL_DIR}/source/hpsv2/src",
      "checkpoint": "${PICKSCORE_PROCESSOR}/open_clip_pytorch_model.bin"
    },
    "hpsv2": {
      "open_clip_source": "${HPSV2_MODEL_DIR}/source/hpsv2/src",
      "checkpoint": "${HPSV2_MODEL_DIR}/HPS_v2_compressed.pt",
      "version": "v2.0"
    },
    "aesthetic": {
      "model": "${AESTHETIC_CLIP_MODEL}",
      "processor": "${AESTHETIC_CLIP_MODEL}",
      "checkpoint": "${AESTHETIC_CHECKPOINT}"
    },
    "hpsv3": {
      "source": "${HPSV3_MODEL_DIR}/source",
      "model": "${HPSV3_BASE_MODEL}",
      "checkpoint": "${HPSV3_MODEL_DIR}/HPSv3.safetensors",
      "config": "${HPSV3_MODEL_DIR}/source/hpsv3/config/HPSv3_7B.yaml",
      "batch_size": 1,
      "disable_flash_attn2": true
    },
    "unifiedreward": {
      "source": "${UNIFIED_REWARD_SOURCE}",
      "source_revision": "ff6f520247a2d36e2aff7b2ba53a935afd437f66",
      "model": "${UNIFIED_REWARD_MODEL}",
      "model_revision": "f14142a59d75cbdf8c0de75aa942f135e4bd3a70",
      "aggregation": "arithmetic_mean_of_alignment_coherence_style",
      "dtype": "bfloat16",
      "batch_size": 1,
      "max_new_tokens": 4096
    },
    "image_reward": {
      "source": "${IMAGE_REWARD_MODEL_DIR}/source",
      "checkpoint": "${IMAGE_REWARD_MODEL_DIR}/ImageReward.pt",
      "config": "${IMAGE_REWARD_MODEL_DIR}/med_config.json",
      "tokenizer": "${IMAGE_REWARD_TOKENIZER}",
      "batch_size": 1
    }
  }
}
