{
  "benchmarks": {
    "pickv2": "${BENCHMARKS_ROOT}/sd15/paper-eval/pickv2.jsonl",
    "hpsv2": "${BENCHMARKS_ROOT}/sd15/paper-eval/hpsv2.jsonl",
    "partiprompts": "${BENCHMARKS_ROOT}/sd15/paper-eval/partiprompts.jsonl",
    "geneval": "${GENEVAL_PROMPTS}",
    "dpg": "${DPG_PROMPTS}"
  },
  "scorers_config": "scorers.json",
  "compositional_config": "compositional.json",
  "protocols": {
    "sd15": {
      "scheduler": "EulerDiscreteScheduler", "dtype": "bfloat16",
      "height": 512, "width": 512, "num_inference_steps": 50,
      "guidance_scale": 7.5, "negative_prompt": "", "seeds": [0],
      "prompt_truncation": "truncate", "safety_checker": "disabled"
    },
    "sdxl": {
      "scheduler": "EulerDiscreteScheduler", "dtype": "bfloat16",
      "height": 1024, "width": 1024, "num_inference_steps": 50,
      "guidance_scale": 5.0, "negative_prompt": "", "seeds": [17],
      "prompt_truncation": "truncate"
    },
    "sd35_medium": {
      "scheduler": "FlowMatchEulerDiscreteScheduler", "dtype": "bfloat16",
      "height": 1024, "width": 1024, "num_inference_steps": 28,
      "guidance_scale": 4.5, "negative_prompt": "", "seeds": [17, 29, 43, 71],
      "max_sequence_length": 256, "prompt_truncation": "truncate", "cpu_offload": true
    },
    "zimage": {
      "scheduler": "FlowMatchEulerDiscreteScheduler", "dtype": "bfloat16",
      "height": 1024, "width": 1024, "num_inference_steps": 50,
      "guidance_scale": 4.0, "negative_prompt": "", "seeds": [17, 29, 43, 71],
      "max_sequence_length": 256, "prompt_truncation": "truncate", "cpu_offload": true
    }
  },
  "benchmark_seeds": {"geneval": [17, 29, 43, 71], "dpg": [17, 29, 43, 71]},
  "metric_groups": {
    "legacy": ["pickscore", "hpsv2", "image_reward", "clip", "aesthetic"],
    "modern": ["hpsv3", "unifiedreward", "pickscore", "image_reward", "clip", "aesthetic"]
  },
  "notes": [
    "SD1.5 sampling is copied from evaluate-selected-sd15.json; SDXL from evaluate-sdxl.json.",
    "The hpsv2 panel is 3200 published rows, not HPDv2 test400. PickV2 has 487 rows.",
    "Base and aligned runs use every scheduled seed; galleries never filter quantitative scores.",
    "GenEval/DPG use four images per prompt independently of legacy preference-panel seeds."
  ]
}
